  "components": {
    "schemas": {
      "CreateCheckingAccountRequest": {
        "required": [
          "accountNumber",
          "balance"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "maximum": 9999999999,
            "minimum": 1000000000,
            "type": "number",
            "format": "double"
          },
          "balance": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "overdrafts": {
            "minimum": 0,
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateSavingAccountRequest": {
        "required": [
          "accountNumber",
          "balance"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "maximum": 9999999999,
            "minimum": 1000000000,
            "type": "number",
            "format": "double"
